{
  "name": "open-social-scheduler-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@open-social/web",
    "dev:api": "npm run dev --workspace=@open-social/api",
    "dev:worker": "npm run dev --workspace=@open-social/worker",
    "build:packages": "npm run build --workspace=@open-social/database --workspace=@open-social/core --workspace=@open-social/providers",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.0"
  }
}

{
  "name": "open-social-scheduler-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@open-social/web",
    "dev:api": "npm run dev --workspace=@open-social/api",
    "dev:worker": "npm run dev --workspace=@open-social/worker",
    "dev:mcp": "node packages/mcp/dist/index.js",
    "build:packages": "npm run build --workspace=@open-social/database --workspace=@open-social/core --workspace=@open-social/providers --workspace=@open-social/mcp",
    "build": "npm run build --workspaces --if-present",
    "seed:demo": "node --experimental-strip-types scripts/seed-demo.ts",
    "test": "node --test --test-concurrency=1 packages/database/dist/encryption.test.js packages/core/dist/state-machine.test.js packages/providers/dist/providers.test.js apps/api/dist/health.test.js apps/worker/dist/worker.test.js packages/mcp/dist/mcp.test.js",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.0"
  }
}

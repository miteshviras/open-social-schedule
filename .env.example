# ==========================================
# Open Social Scheduler Configuration
# ==========================================

# Environment Mode
NODE_ENV=development
PORT=3000
API_PORT=4000

# ------------------------------------------
# Database Configuration
# ------------------------------------------
# For zero-setup local dev with SQLite:
DATABASE_URL="file:./dev.db"

# For PostgreSQL (e.g. Docker Compose):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/social_scheduler?schema=public"

# ------------------------------------------
# Security & Credential Encryption
# ------------------------------------------
# A secure 32+ character key used for AES-256-GCM encryption of OAuth tokens at rest.
# Keep this secret! Never commit your actual key to git.
ENCRYPTION_SECRET=replace_with_a_secure_random_32_char_secret_key!

# Session secret for web UI cookies (if local session auth is enabled)
SESSION_SECRET=replace_with_a_random_session_secret_string

# ------------------------------------------
# LinkedIn Developer Application
# ------------------------------------------
# Create an app at https://www.linkedin.com/developers/
# Required Products: "Sign In with LinkedIn using OpenID Connect", "Share on LinkedIn"
LINKEDIN_SCOPES=openid,profile,w_member_social
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback

# ------------------------------------------
# X (Twitter) Developer Application
# ------------------------------------------
# Create an app at https://developer.x.com/en/portal/dashboard
# User authentication settings: OAuth 2.0 PKCE, Read and Write, Native App or SPA / Web App
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
X_REDIRECT_URI=http://localhost:3000/api/auth/x/callback

# ------------------------------------------
# Worker Configuration
# ------------------------------------------
# Polling interval in seconds for due-job acquisition
WORKER_POLL_INTERVAL_SECONDS=5
# Maximum concurrent publishing executions
WORKER_CONCURRENCY=3
# Lease timeout in seconds before an in-progress publishing job is considered stalled
WORKER_LEASE_DURATION_SECONDS=60
